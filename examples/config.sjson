// ~/.config/kroken/config.sjson
//
// Every key is optional. Run `kroken config` to see the effective values,
// including the default prompts. See doc/configuration.md for the schema.

// backend = "claude"                 // or "codex"; --backend overrides per run

claude = {
    // command = "claude"
    // model = "opus"
    // effort = "high"
    tools = ["Read", "Grep", "Glob"]   // read-only; [] turns tools off entirely
    // extra_args = ["--permission-prompts", "none"]
    // max_budget_usd = 0.5
}

codex = {
    // command = "codex"
    // model = "gpt-5.5"
    // effort = "high"                 // minimal, low, medium, high, xhigh
    sandbox = "read-only"              // workspace-write lets it edit files, which kroken never needs
}

log = {
    enabled = true
    // directory = "~/.local/state/kroken/log"
}
