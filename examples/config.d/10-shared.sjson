// ~/.config/kroken/config.d/10-shared.sjson
//
// Safe to commit to a dotfiles repository: no secrets, no machine paths.

profiles = {
    fast = {
        claude = {
            model = "sonnet"
            effort = "low"
        }
    }

    // Same workflow on OpenAI's side. Select with `profile = "openai"` in a
    // .kroken file or `kroken complete --profile openai`.
    openai = {
        backend = "codex"
        codex = {
            model = "gpt-5.5"
            effort = "high"
        }
    }
}
